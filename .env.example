# ============================================================
# LARK-MAIL 环境变量示例
# 使用: cp .env.example .env ,然后编辑 .env 填入真实配置
# (.env 已被 .gitignore 忽略,不会提交到仓库)
# ============================================================

# ------------------------------------------------------------
# 方式一:【单账户模式】(未设置 MAIL_ACCOUNTS_JSON 时生效)
# ------------------------------------------------------------
IMAP_SERVER=imap.163.com            # IMAP 服务器地址
IMAP_PORT=993                       # IMAP SSL 端口
MAILBOX=INBOX                       # 监听的邮箱文件夹
IMAP_USER=your_email@163.com        # 邮箱账号
IMAP_PASS=your_auth_code            # 授权码,不是登录密码!
FEISHU_WEBHOOKS=https://open.feishu.cn/open-apis/bot/v2/hook/your_webhook
BLOCKED_KEYWORDS=                   # 屏蔽词,中英文逗号分隔(可选,如: 广告,推广)
BLOCKED_SENDERS=                    # 屏蔽发件人,中英文逗号分隔(可选,如: APS,spam@x.com)
POLL_INTERVAL=60                    # 轮询间隔(秒)
BLOCK_BEFORE=86400                  # 跳过 24 小时(86400 秒)前的邮件
MAX_EMAILS_PER_RUN=50               # 每次轮询最多处理 50 封
MAX_RETRIES=3                       # 推送失败重试上限,超限后标记已读放弃
RECONNECT_INTERVAL=600              # 连接复用:每 600 秒(10 分钟)强制重连一次
BATCH_DELAY=2                       # 每封邮件间隔 2 秒,防飞书限流
DEBUG=false                         # true 时输出 IMAP 交互详情

# ------------------------------------------------------------
# 方式二:【多账户模式】(推荐,可同时监控多个邮箱)
# 设置 MAIL_ACCOUNTS_JSON 后,脚本【优先】使用它,
# 上面方式一的单账户变量会被忽略。
#
# ⚠️⚠️⚠️ 重要:JSON 必须写成【一整行】,严禁换行!
#   换行会导致 JSON 解析失败,服务无法启动。
#
# 字段说明:
#   imap_user          邮箱账号(必填)
#   imap_pass          授权码,不是登录密码(必填)
#   feishu_webhook     飞书机器人 Webhook 地址(必填)
#   blocked_keywords   屏蔽词,中英文逗号分隔;命中主题/正文则跳过(可选)
#   blocked_senders    屏蔽发件人,中英文逗号分隔;命中From头则跳过(可选)
#   max_retries        推送失败重试上限(可选,默认 3,超限后标记已读放弃)
#   reconnect_interval 连接复用强制重连间隔秒数(可选,默认 600)
#
# 示例:两个账户,按需增删,账户之间用逗号分隔
# ------------------------------------------------------------
MAIL_ACCOUNTS_JSON=[{"imap_user":"user1@163.com","imap_pass":"授权码1","feishu_webhook":"https://open.feishu.cn/open-apis/bot/v2/hook/xxx","blocked_keywords":"广告,推广"},{"imap_user":"user2@qq.com","imap_pass":"授权码2","feishu_webhook":"https://open.feishu.cn/open-apis/bot/v2/hook/yyy","blocked_keywords":""}]
